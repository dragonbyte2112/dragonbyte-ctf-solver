# --- AI provider configuration ---
# Choose ONE: anthropic | openai | ollama | (leave blank to run with no AI, deterministic-only)
AI_PROVIDER=anthropic

# Required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if AI_PROVIDER=ollama (local, no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Server ---
# Comma-separated list of allowed origins, or * for any (fine for local dev only)
CORS_ORIGINS=*
